# Required runtime configuration
DATABASE_URL="postgresql://user:password@host:5432/the-code-of-life"
FRONTEND_URL="http://localhost:3000"

# Required JWT signing secrets
# Generate long random values for both before starting the backend.
JWT_SECRET="replace-with-a-long-random-access-token-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-token-secret"

# Optional server configuration
PORT=3001

# Comma-separated list of allowed CORS origins (defaults to localhost:3000 if not set)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional SMTP mail transport for verification and password reset emails.
# If unset, the backend logs reset/verification links instead of sending mail.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="smtp-user"
# SMTP_PASS="smtp-password"
# SMTP_FROM="The Code of Life <noreply@thecodeoflife.com>"
